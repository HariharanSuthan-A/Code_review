# -------------------------------------------------------------------
# LLM provider — works with any OpenAI-compatible chat completions API
# -------------------------------------------------------------------
# "ollama" (default, fully local) | "openai" | "openai_compatible"
LLM_PROVIDER=ollama

# Base URL of the OpenAI-compatible endpoint.
#   Ollama:            http://localhost:11434/v1
#   OpenAI:             https://api.openai.com/v1
#   OpenRouter:          https://openrouter.ai/api/v1
#   LM Studio / vLLM:    http://localhost:1234/v1  (whatever you run locally)
LLM_BASE_URL=http://localhost:11434/v1

# API key. Ollama ignores this but the client library still requires a
# non-empty string — any placeholder value works.
LLM_API_KEY=ollama-local-key

# Model name as your provider expects it, e.g.:
#   Ollama:    llama3.1 | qwen2.5:14b | mistral-nemo
#   OpenAI:     gpt-4o-mini | gpt-4o
LLM_MODEL=gpt-oss:20b-cloud

LLM_TEMPERATURE=0.1

# -------------------------------------------------------------------
# Storage
# -------------------------------------------------------------------
HISTORY_DB_PATH=workbooks/history.sqlite3

# -------------------------------------------------------------------
# Voice (planned Phase 2 — STT/TTS re-attaches via /ws/agent)
# -------------------------------------------------------------------
# Excela AI is text-only (chat) for now. Voice (speech-to-text /
# text-to-speech) will reuse the existing /ws/agent status-stream contract
# ("Listening..." / "Analyzing..." / "Updating Excel..." / "✓ Completed"),
# so the agent and tool layers stay voice-ready with no rearchitecting.
